					<paragraph leftIndent="30"/>
				</textElement>
				<text><![CDATA[Формулировка вопроса, поставленного на голосование:]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="22" y="180" width="508" height="30" uuid="3e27cae6-c53f-4bc9-b432-8689130df9a8"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Отчет временного управляющего " + $P{debtor}.getName() + " " + $P{arbitrationManager}.getFullName() + " о проведении процедуры наблюдения."]]></textFieldExpression>
			</textField>
