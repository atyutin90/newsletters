					<font fontName="Times New Roman" isBold="true"/>
				</textElement>
				<text><![CDATA[БЮЛЛЕТЕНЬ № 1
для голосования участников первого собрания кредиторов
]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="22" y="30" width="508" height="30" uuid="19cc8b4e-d2b3-4446-8e0f-e8f23b62da15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Собрание кредиторов " + ($P{debtor} != null ? $P{debtor}.getName() : "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="22" y="60" width="508" height="30" uuid="91adb5a7-6d52-4805-a1f4-f02cbcfc6157"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{debtorMeeting} != null ? $P{debtorMeeting}.getAddress() : null)]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="22" y="90" width="508" height="30" uuid="b6a86a7a-194b-4f27-9059-e40ff3c1ff05"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" isBold="true"/>
