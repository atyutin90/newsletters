				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Бюллетень для голосования по первому вопросу повестки дня]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="22" y="150" width="508" height="30" uuid="c4e9a97d-695c-4f01-86c0-d9f63ec0f0dd">
