				</textElement>
				<text><![CDATA[ВРЕМЕННЫЙ УПРАВЛЯЮЩИЙ]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="20" width="495" height="20" uuid="19cc8b4e-d2b3-4446-8e0f-e8f23b62da15"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph lineSpacingSize="0.0"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{debtor} != null ? $P{debtor}.getFullName() : ""]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="50" width="495" height="20" uuid="85a39cd3-d5a1-4823-8638-cf0d0b309921"/>
				<box>
					<topPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph lineSpacingSize="0.0"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{arbitrationManager} != null ? ($P{arbitrationManager}.getPostalAddress() != null ? $P{arbitrationManager}.getPostalAddress() + " " : "") + ($P{arbitrationManager}.getEmail() != null ? $P{arbitrationManager}.getEmail() + " " : "") + ($P{arbitrationManager}.getPhone() != null ? $P{arbitrationManager}.getPhone() : "") : ""]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="90" width="220" height="20" uuid="6cf58d8f-30eb-4a67-b0cf-4ce4bc4998a1"/>
				<box>
					<topPen lineStyle="Solid"/>
					<leftPen lineStyle="Solid"/>
					<bottomPen lineStyle="Solid"/>
					<rightPen lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none">
					<font fontName="Times New Roman" size="12"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Исх. № "+ $P{requestNumber} + " " + ($P{debtor}.getDocumentNumber() != null ? $P{debtor}.getDocumentNumber() : "") + " от " + ($P{request}.getDate() != null ? $P{request}.getDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="220" y="90" width="275" height="20" uuid="c13433d4-2e0c-47fa-a486-621d0c8037fb"/>
				<box>
					<topPen lineStyle="Solid"/>
					<leftPen lineStyle="Solid"/>
					<bottomPen lineStyle="Solid"/>
					<rightPen lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="none">
					<font fontName="Times New Roman" size="12"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{request}.getDestination() + "\n" + $P{request}.getDestinationDetail() + "\n" + $P{request}.getAddress()]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="130" width="495" height="20" uuid="db06af2a-01ea-460e-9907-52e3a3ac7bc8"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Запрос]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="150" width="495" height="120" uuid="38c68692-45cc-423a-92a9-f6791be11d68"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	Определением " + $P{debtor}.getCourtAct() + " от " + ($P{debtor}.getActDate() != null ? $P{debtor}.getActDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "") + "(" + ($P{debtor}.getResolutionDate() != null ? $P{debtor}.getResolutionDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) : "") +") по делу " + $P{debtor}.getCaseNumber() + " в отношении должника " + $P{debtor}.getName() + " (ИНН "+ $P{debtor}.getTaxpayerIdentificationNumber() + ", ОГРН " + $P{debtor}.getPrimaryStateRegistrationNumber() + ", адрес: " + $P{debtor}.getAddress() + "), введена процедура наблюдения. Временным управляющим назначена " + $P{arbitrationManager}.getFullName() + " (ИНН " +$P{arbitrationManager}.getTaxpayerIdentificationNumber() + " СНИЛС " +$P{arbitrationManager}.getPersonalInsurancePolicyNumber() + ", член " + $P{arbitrationManager}.getSroData() + ").\t\n" +
"	На основании абз. 7 п. 1 ст. 20.3 Федерального закона от 26.10.2002 № 127-ФЗ «О несостоятельности (банкротстве)» Арбитражный управляющий имеет право запрашивать необходимые сведения о должнике, о лицах, входящих в состав органов управления должника, о контролирующих лицах, о принадлежащем им имуществе (в том числе имущественных правах), о контрагентах и об обязательствах должника у физических лиц, юридических лиц, государственных органов, органов управления государственными внебюджетными фондами Российской Федерации и органов местного самоуправления, включая сведения, составляющие служебную, коммерческую и банковскую тайну. На основании вышеизложенного, прошу предоставить информацию (на бумажном или электронном носителе) о движении денежных средств по  расчетному счету , открытым в банке в отношении должника " + ($P{debtor} != null ? $P{debtor}.getFullName() : "") +" в период " + ($P{request}.getDateFrom() != null ? $P{request}.getDateFrom().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "") + " - " + ($P{request}.getDateTo() != null ? $P{request}.getDateTo().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) : "") + ".\t\n" +
"	Данная информация необходима временному управляющему для проведения анализа финансово-хозяйственной деятельности и подготовки заключения о наличии или об отсутствии оснований для оспаривания сделок должника в соответствии со ст.67 Закона о банкротстве.\t\n" +
"	Напоминаю, что в соответствии с п. 1 ст. 20.3 Закона о банкротстве физические лица, юридические лица, государственные органы, органы управления государственными внебюджетными фондами Российской Федерации и органы местного самоуправления представляют запрошенные арбитражным управляющим сведения в течение семи дней со дня получения запроса без взимания платы.\t\n" + 
"	Запрашиваемую информацию прошу направить на имя временного управляющего " +($P{arbitrationManager} != null && $P{arbitrationManager}.getFullName() != null ? $P{arbitrationManager}.getFullName(): "") + " по адресу: " + ($P{arbitrationManager} != null && $P{arbitrationManager}.getPostalAddress() != null ? $P{arbitrationManager}.getPostalAddress(): "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="280" width="495" height="30" uuid="798be35b-d5c4-4640-98ed-cf604c1c2986"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	Приложение:\n" +
"- копия определения Арбитражного суда от " + ($P{debtor}.getActDate() != null ? $P{debtor}.getActDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) : "")+ " (резолютивная часть объявлена "+ ($P{debtor}.getResolutionDate() != null ? $P{debtor}.getResolutionDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "") +") по делу " + $P{debtor}.getCaseNumber()]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="350" width="270" height="40" uuid="c6c07a3b-c3dd-4676-9a05-ba6c95cd7928"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph leftIndent="6"/>
				</textElement>
				<textFieldExpression><![CDATA["Временный управляющий \n" + ($P{debtor} != null ? $P{debtor}.getName() : "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="270" y="350" width="225" height="40" uuid="910a86f6-cd88-4ba0-93b6-c5e035ad4aa5"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph leftIndent="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{arbitrationManager} != null ? $P{arbitrationManager}.getFullName() : ""]]></textFieldExpression>
			</textField>
		</band>
	</detail>
