	<field name="id" class="java.lang.Long"/>
	<detail>
		<band height="790">
			<staticText>
				<reportElement positionType="Float" x="22" y="0" width="508" height="20" uuid="56fd2fdd-48c6-41a8-9189-22ad4bdb4225"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[ВРЕМЕННЫЙ УПРАВЛЯЮЩИЙ]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="20" width="508" height="20" uuid="19cc8b4e-d2b3-4446-8e0f-e8f23b62da15"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{debtor} != null ? $P{debtor}.getFullName() : ""]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="50" width="508" height="20" uuid="85a39cd3-d5a1-4823-8638-cf0d0b309921"/>
				<box>
					<topPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{arbitrationManager} != null ? ($P{arbitrationManager}.getPostalAddress() != null ? $P{arbitrationManager}.getPostalAddress() + " " : "") + ($P{arbitrationManager}.getEmail() != null ? $P{arbitrationManager}.getEmail() + " " : "") + ($P{arbitrationManager}.getPhone() != null ? $P{arbitrationManager}.getPhone() : "") : ""]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="110" width="508" height="20" uuid="db06af2a-01ea-460e-9907-52e3a3ac7bc8"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Уведомление]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="130" width="508" height="70" uuid="38c68692-45cc-423a-92a9-f6791be11d68"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	Определением " + $P{debtor}.getCourtAct() + " от " + ($P{debtor}.getActDate() != null ? $P{debtor}.getActDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "") + "(" + ($P{debtor}.getResolutionDate() != null ? $P{debtor}.getResolutionDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) : "") +") по делу " + $P{debtor}.getCaseNumber() + " в отношении должника " + $P{debtor}.getName() + " ("+ $P{debtor}.getTaxpayerIdentificationNumber() + ", " + $P{debtor}.getPrimaryStateRegistrationNumber() + ", " + $P{debtor}.getAddress() + "), введена процедура наблюдения. Временным управляющим назначена " + $P{arbitrationManager}.getFullName() + " (" +$P{arbitrationManager}.getTaxpayerIdentificationNumber() + " " +$P{arbitrationManager}.getPersonalInsurancePolicyNumber() + ", член " + $P{arbitrationManager}.getSroData() + ")."]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="200" width="508" height="50" uuid="f8cccb4b-0624-4e52-aa72-0227b2d89418"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	В соответствии со ст. 12.1 ФЗ «О несостоятельности (банкротстве)» временный управляющий " + $P{debtor}.getName() + " уведомляет о проведении собрания работников, бывших работников должника. Собрание состоится " + ($P{workerMeeting}.getDate() != null ? $P{workerMeeting}.getDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "") + " в " + $P{workerMeeting}.getTime() + " по адресу: " + $P{workerMeeting}.getAddress()]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="250" width="508" height="30" uuid="6e847568-d68f-4efb-a60c-1c3934c1a39c"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	Повестка дня собрания работников, бывших работников " + $P{debtor}.getName() +":"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="280" width="508" height="30" uuid="469bb964-6148-487b-b465-55e98c147a77"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[	1. О выборе представителя работников, бывших работников должника.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="310" width="508" height="40" uuid="d0f3c151-4da2-4e77-892e-07da50ed4057"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	Начало регистрации участников собрания: " + $P{workerMeeting}.getRegistrationTimeFrom() + ". Окончание регистрации участников собрания:  " + $P{workerMeeting}.getRegistrationTimeTo() + "."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="350" width="508" height="60" uuid="8bb8e36e-0401-4019-a3ad-d9c421226571"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<text><![CDATA[	Для участия в собрании работник, бывший работник представляет документ, удостоверяющий личность. В случае невозможности личного участия в собрании, представитель работника, бывшего работника имеет право участвовать в собрании по нотариально заверенной доверенности.]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="22" y="480" width="289" height="40" uuid="c6c07a3b-c3dd-4676-9a05-ba6c95cd7928"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph leftIndent="6"/>
				</textElement>
				<textFieldExpression><![CDATA["Временный управляющий \n" + ($P{debtor} != null ? $P{debtor}.getName() : "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="311" y="480" width="219" height="40" uuid="910a86f6-cd88-4ba0-93b6-c5e035ad4aa5"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph leftIndent="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{arbitrationManager} != null ? $P{arbitrationManager}.getFullName() : ""]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
