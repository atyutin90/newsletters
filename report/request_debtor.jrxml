<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="request_debtor" pageWidth="595" pageHeight="842" columnWidth="495" leftMargin="60" rightMargin="40" topMargin="20" bottomMargin="20" whenResourceMissingType="Empty" uuid="ce10ff5c-ec10-41c5-98be-757724372bec">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="debtor" class="com.example.newsletters.entity.Debtor"/>
	<parameter name="request" class="com.example.newsletters.entity.Request"/>
	<parameter name="arbitrationManager" class="com.example.newsletters.entity.ArbitrationManager"/>
	<queryString>
		<![CDATA[]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<detail>
		<band height="790">
			<property name="com.jaspersoft.studio.layout"/>
			<staticText>
				<reportElement positionType="Float" x="0" y="0" width="495" height="20" uuid="56fd2fdd-48c6-41a8-9189-22ad4bdb4225">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph lineSpacingSize="0.0"/>
				</textElement>
				<text><![CDATA[ВРЕМЕННЫЙ УПРАВЛЯЮЩИЙ]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="20" width="495" height="20" uuid="19cc8b4e-d2b3-4446-8e0f-e8f23b62da15"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph lineSpacingSize="0.0"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{debtor} != null ? $P{debtor}.getFullName() : ""]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="50" width="495" height="20" uuid="85a39cd3-d5a1-4823-8638-cf0d0b309921"/>
				<box>
					<topPen lineWidth="1.0"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph lineSpacingSize="0.0"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{arbitrationManager} != null ? ($P{arbitrationManager}.getPostalAddress() != null ? $P{arbitrationManager}.getPostalAddress() + " " : "") + ($P{arbitrationManager}.getEmail() != null ? $P{arbitrationManager}.getEmail() + " " : "") + ($P{arbitrationManager}.getPhone() != null ? $P{arbitrationManager}.getPhone() : "") : ""]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="90" width="220" height="20" uuid="6cf58d8f-30eb-4a67-b0cf-4ce4bc4998a1"/>
				<box>
					<topPen lineStyle="Solid"/>
					<leftPen lineStyle="Solid"/>
					<bottomPen lineStyle="Solid"/>
					<rightPen lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="none">
					<font fontName="Times New Roman" size="12"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Исх. № " + ($P{debtor}.getDocumentNumber() != null ? $P{debtor}.getDocumentNumber() : "") + " от " + ($P{request}.getDate() != null ? $P{request}.getDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="220" y="90" width="275" height="20" uuid="c13433d4-2e0c-47fa-a486-621d0c8037fb"/>
				<box>
					<topPen lineStyle="Solid"/>
					<leftPen lineStyle="Solid"/>
					<bottomPen lineStyle="Solid"/>
					<rightPen lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="none">
					<font fontName="Times New Roman" size="12"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{request}.getDestination().getName() + "\n" + $P{request}.getAddress()]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="0" y="130" width="495" height="20" uuid="db06af2a-01ea-460e-9907-52e3a3ac7bc8"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Запрос]]></text>
			</staticText>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="150" width="495" height="120" uuid="38c68692-45cc-423a-92a9-f6791be11d68"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	Определением " + $P{debtor}.getCourtAct() + " от " + ($P{debtor}.getActDate() != null ? $P{debtor}.getActDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "") + "(" + ($P{debtor}.getResolutionDate() != null ? $P{debtor}.getResolutionDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) : "") +") по делу " + $P{debtor}.getCaseNumber() + " в отношении должника " + $P{debtor}.getName() + " ("+ $P{debtor}.getTaxpayerIdentificationNumber() + ", " + $P{debtor}.getPrimaryStateRegistrationNumber() + ", " + $P{debtor}.getAddress() + "), введена процедура наблюдения. Временным управляющим назначена " + $P{arbitrationManager}.getFullName() + " (" +$P{arbitrationManager}.getTaxpayerIdentificationNumber() + " " +$P{arbitrationManager}.getPersonalInsurancePolicyNumber() + ", член " + $P{arbitrationManager}.getSroData() + ").\t\n\t\n" +
"	В соответствии с пунктом 3.2. статьи 64 Федерального закона «О несостоятельности (банкротстве)» не позднее пятнадцати дней с даты утверждения временного управляющего руководитель должника обязан предоставить временному управляющему и направить в арбитражный суд перечень имущества должника, в том числе имущественных прав, а также бухгалтерские и иные документы, отражающие экономическую деятельность должника за три года до введения процедуры наблюдения. Ежемесячно руководитель должника обязан информировать временного управляющего об изменениях в составе имущества должника (п. 3.2 введен Федеральным законом от 30.12.2008 N 296-ФЗ).\t\n" +
"	В целях реализации основных задач наблюдения (проведение анализа финансового состояния должника, принятия мер по обеспечению сохранности имущества должника, установления кредиторов и размеров их требований) и в соответствии с пунктом 2 статьи 66 Федерального закона «О несостоятельности (банкротстве)» прошу Вас представить мне следующие сведения и документы о деятельности " + $P{debtor}.getName() +" (документы необходимо представить в виде заверенной Вами копии, сведения – за Вашей подписью): \t\n" +
"	1. Список кредиторов " + $P{debtor}.getName() +" с указанием полного наименования (Ф.И.О. или наименование юр. лица) кредитора, его места нахождения (места жительства) или фактического адреса, а также документы, подтверждающие эти обязательства. Под кредиторами подразумеваются все лица, которые по договору или иным гражданско-правовым основаниям имеют (или могут иметь в пределах процедуры наблюдения) имущественные притязания к " + $P{debtor}.getName() +".\t\n" +
"	2. Копии учредительных документов "+ $P{debtor}.getName() + " (со всеми изменениями и дополнениями).\t\n" +
"	3. Список недвижимого имущества, находящегося в собственности " + $P{debtor}.getName() + ", а также документы, подтверждающие права " + $P{debtor}.getName() + " на недвижимое имущество (при наличии такого имущества).\t\n" +
"	4. Перечень государственного имущества, находящегося на балансе предприятия с указанием  основания возникновения правоотношений (если таковое имеется).\t\n" +
"	5. Перечень имущества, которое находится у должника на хранении, в пользовании либо в аренде, с указанием организаций собственников данного имущества с указанием основания возникновения данных правоотношений.\t\n" +
"	6. Перечень дебиторской задолженности с приложением документов, подтверждающих размер и основание её возникновения.\t\n" +
"	7. Внутренние документы " + $P{debtor}.getName() + ", в том числе положения об органах управления " + $P{debtor}.getName() + " о порядке образования фондов и др.\t\n" +
"	8. Приказы и распоряжения руководителя " + $P{debtor}.getName() + " (за исключением приказов по кадровому составу) изданные с " + ($P{request}.getDateFrom() != null ? $P{request}.getDateFrom().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "") + " - " + ($P{request}.getDateTo() != null ? $P{request}.getDateTo().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy")) : "") + ".\t\n" +
"	9. Ежегодные отчеты ревизионной комиссии о результатах " + $P{debtor}.getName() + ", заключения аудиторов (аудиторских фирм) (за последние два года деятельности).\t\n" +
"	10. Договоры (соглашения, контракты и т.п.), заключенные " + $P{debtor}.getName() + " со всеми контрагентами, банками и иными кредитными организациями, иными коммерческими и некоммерческими организациями, государственными органами, физическими лицами (необходимо представить договоры, неисполненные со стороны " + $P{debtor}.getName() + ", а также договоры, в которых срок исполнения обязательств " + $P{debtor}.getName() + " наступит в пределах процедуры наблюдения).\t\n" +
"	11. Номера расчетного (текущего) и иных счетов " + $P{debtor}.getName() + " и его подразделений, наименование и реквизиты обслуживающих эти счета банков.\t\n" +
"	12. Квартальные и годовые документы бухгалтерской отчетности " + $P{debtor}.getName() + " (с соответствующими отметками налогового органа об их принятии) (за последние три года деятельности " + $P{debtor}.getName() + "), приказы о принятии учетной политики " + $P{debtor}.getName() + " последние акты об инвентаризации имущества и финансовых обязательств " + $P{debtor}.getName() + " и последние инвентаризационные ведомости;\t\n" +
"	13. Справки о задолженности " + $P{debtor}.getName() + " перед бюджетом и внебюджетными фондами на последнюю отчетную дату.\t\n" +
"	14. Лицензии, сертификаты.\t\n" +
"	15. Сведения об основных направлениях деятельности " + $P{debtor}.getName() + " (основных видах работ, услуг).\t\n" +
"	16. Сведения о наличии у " + $P{debtor}.getName() + " ликвидного имущества, в том числе ценных бумаг.\t\n" +
"	17. Сведения об обременении имущества (активов) " + $P{debtor}.getName() + " обязательствами третьих лиц (сданы ли в аренду, переданы ли в залог).\t\n" +
"	18. Сведения о том, имеются ли притязания третьих лиц на имущество (активы) " + $P{debtor}.getName() + " (судебные споры, определения судов, действия судебных исполнителей, органов налоговой полиции и т.д.).\t\n" +
"	19. Сведения о внутренней структуре " + $P{debtor}.getName() + ", перечень его структурных подразделений, в том числе обособленных структурных подразделений (филиалов и представительств).\t\n" +
"	20. Сведения о фактической численности работников " + $P{debtor}.getName() + " утвержденное штатное расписание " + $P{debtor}.getName() + ", полный список сотрудников на дату введения процедуры наблюдения с указанием их почтовых адресов.\t\n" +
"	21. Сведения о выданных " + $P{debtor}.getName() + "  доверенностях.\t\n" +
"	22. Сведения об организациях, в которых " + $P{debtor}.getName() + " является учредителем (участником), сведения о порядке участия " + $P{debtor}.getName() + ", о наличии договоров с ними.\t\n" +
"	23. Правовые акты Президента Российской Федерации, Правительства Российской Федерации, федеральных органов исполнительной власти, органов исполнительной власти субъекта Российской Федерации (необходимы только индивидуальные правовые акты, касающиеся " + $P{debtor}.getName() + " либо его функций и видов деятельности, если такие акты издавались).\t\n" +
"	24. Сведения об организации и функционировании службы безопасности (охраны) " + $P{debtor}.getName() + ", о материально ответственных лицах и лицах, ответственных за технику безопасности на производстве и пожарную безопасность (с предоставлением соответствующих приказов).\t\n" +
"	В соответствии с п.1 ст.20.3 ФЗ «О несостоятельности (банкротстве)» №127 ФЗ от 27.09.2002г. юридические лица, государственные органы, органы управления государственными внебюджетными фондами Российской Федерации и органы местного самоуправления представляют запрошенные арбитражным управляющим сведения в течение семи дней со дня получения запроса без взимания платы."]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="280" width="495" height="20" uuid="798be35b-d5c4-4640-98ed-cf604c1c2986"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	Запрашиваемую информацию прошу направить на имя временного управляющего "  + $P{arbitrationManager}.getFullName()  + " по адресу: " + $P{arbitrationManager}.getPostalAddress()]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="310" width="495" height="20" uuid="dc8a7240-88c6-4e9f-8fa2-4351b27b079a"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["	Приложение:\n" +
"- копия определения Арбитражного суда от " + ($P{debtor}.getActDate() != null ? $P{debtor}.getActDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "")+ " (резолютивная часть объявлена "+ ($P{debtor}.getResolutionDate() != null ? $P{debtor}.getResolutionDate().format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy", $P{REPORT_LOCALE})) : "") +") по делу " + $P{debtor}.getCaseNumber()]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="0" y="370" width="270" height="40" uuid="c6c07a3b-c3dd-4676-9a05-ba6c95cd7928"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph leftIndent="6"/>
				</textElement>
				<textFieldExpression><![CDATA["Временный управляющий \n" + ($P{debtor} != null ? $P{debtor}.getName() : "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="270" y="370" width="225" height="40" uuid="910a86f6-cd88-4ba0-93b6-c5e035ad4aa5"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph leftIndent="6"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{arbitrationManager} != null ? $P{arbitrationManager}.getFullName() : ""]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
